import heapq
from math import inf


def dijkstra(grafo, inicio):
    distancias = {vertice: inf for vertice in grafo}
    distancias[inicio] = 0
    fila = [(0, inicio)]

    while fila:
        distancia_atual, atual = heapq.heappop(fila)
        if distancia_atual > distancias[atual]:
            continue

        for vizinho, peso in grafo[atual]:
            nova_distancia = distancia_atual + peso
            if nova_distancia < distancias[vizinho]:
                distancias[vizinho] = nova_distancia
                heapq.heappush(fila, (nova_distancia, vizinho))

    return distancias


def ler_inteiro(mensagem, minimo=0):
    while True:
        try:
            numero = int(input(mensagem))
        except ValueError:
            print("Erro! Digite um numero inteiro valido.")
            continue

        if numero < minimo:
            print(f"Erro! Digite um numero maior ou igual a {minimo}.")
            continue

        return numero


def main():
    grafo = {}
    qtd_vertices = ler_inteiro("Digite a quantidade de vertices do grafo: ", 1)

    for i in range(qtd_vertices):
        while True:
            vertice = input(f"Nome do vertice {i + 1}: ").strip()
            if not vertice:
                print("Erro! O nome do vertice nao pode ser vazio.")
                continue
            if vertice in grafo:
                print("Erro! Vertice ja cadastrado.")
                continue

            grafo[vertice] = []
            break

    qtd_arestas = ler_inteiro("Digite a quantidade de arestas do grafo: ", 0)
    arestas = set()

    for i in range(qtd_arestas):
        print(f"\nAresta {i + 1}:")
        while True:
            origem = input("Origem: ").strip()
            destino = input("Destino: ").strip()

            if origem not in grafo:
                print("Erro! Vertice de origem nao existe.")
                continue
            if destino not in grafo:
                print("Erro! Vertice de destino nao existe.")
                continue
            if (origem, destino) in arestas:
                print("Erro! Aresta ja cadastrada.")
                continue

            peso = ler_inteiro("Peso da aresta: ", 0)
            grafo[origem].append((destino, peso))
            arestas.add((origem, destino))
            break

    print("\n========== GRAFO ORIENTADO ==========")
    for vertice, vizinhos in grafo.items():
        print(f"{vertice} -> {vizinhos}")

    while True:
        inicio = input("Vertice inicial: ").strip()
        if inicio in grafo:
            break
        print("Erro! Vertice nao encontrado.")

    resultado = dijkstra(grafo, inicio)
    print("\n========== MENORES DISTANCIAS ==========")
    for vertice, distancia in resultado.items():
        if distancia == inf:
            print(f"{inicio} -> {vertice} = sem caminho")
        else:
            print(f"{inicio} -> {vertice} = {distancia}")


if __name__ == "__main__":
    main()

